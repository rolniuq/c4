#!/usr/bin/env bash
# C4 Pre-commit Hook
#
# Install: git config core.hooksPath .githooks
#
# Runs on every commit. If it exits non-zero, the commit is blocked.
# This ensures no one claims DONE without running the full gate.

set -euo pipefail

ROOT="$(cd "$(dirname "$0")/.." && pwd)"
echo "==> Running C4 pre-commit checks..."

# Only check changed files
CHANGED_FILES=$(git diff --cached --name-only --diff-filter=ACMR | head -50)

if [[ -z "$CHANGED_FILES" ]]; then
  echo "  → No staged files. Skipping pre-commit checks."
  exit 0
fi

# Check if c4.sh was modified — validate bash syntax
if echo "$CHANGED_FILES" | grep -q "c4.sh"; then
  bash -n "$ROOT/c4.sh" && echo "  ✓ c4.sh syntax OK" || {
    echo "  ✗ c4.sh has syntax errors. Fix before committing."
    exit 1
  }
fi

# Check if plugin .ts was modified — validate basic structure
if echo "$CHANGED_FILES" | grep -q "c4-plugin.ts"; then
  grep -q "export default" "$ROOT/.opencode/plugins/c4-plugin.ts" && \
    echo "  ✓ Plugin exports default" || {
    echo "  ✗ Plugin missing export default"
    exit 1
  }
  for tool in c4_init c4_validate_plan c4_validate_report c4_log; do
    grep -q "${tool}:" "$ROOT/.opencode/plugins/c4-plugin.ts" && \
      echo "  ✓ Plugin defines ${tool}" || {
      echo "  ✗ Plugin missing ${tool}"
      exit 1
    }
  done
fi

# Check for build artifacts being committed
if echo "$CHANGED_FILES" | grep -qE "\.tmp$|/node_modules/|/dist/|/build/|/out/|\.turbo/"; then
  echo "  ✗ Build artifacts in commit! Remove them first."
  exit 1
fi

echo "  ✅ Pre-commit checks passed."
